# Vigil environment. Copy to .env and fill in. NEVER commit .env (hard rule #2).
# This file holds NAMES ONLY — never paste a real value here, it is committed.

# --- Alpaca paper account ---------------------------------------------------
# From https://app.alpaca.markets/paper/dashboard/overview -> "API Keys"
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Hard rule #1: paper only. Code asserts this is exactly "true" before any client
# is constructed. There is no supported way to set this to anything else.
ALPACA_PAPER_TRADE=true

# --- OpenAI (LLM portfolio manager; not used until Day 3) -------------------
OPENAI_API_KEY=

# --- API service (not used until Day 3) -------------------------------------
# Bearer token for mutating control routes. Generate: openssl rand -hex 32
API_CONTROL_TOKEN=

# --- Journal (PLAN §3) ------------------------------------------------------
# postgres:// and postgresql:// are both accepted and rewritten to the asyncpg
# driver, so a URL copied from Docker or a host provider works unchanged.
DATABASE_URL=postgresql+asyncpg://localhost/vigil
